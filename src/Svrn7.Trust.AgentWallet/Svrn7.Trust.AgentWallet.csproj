<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Svrn7.Trust.AgentWallet</RootNamespace>
    <AssemblyName>Svrn7.Trust.AgentWallet</AssemblyName>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Svrn7.Trust.AgentWallet</PackageId>
    <Description>Password-protected wallet for a SVRN7 TDA agent identity: Argon2id + AES-256-GCM at-rest encryption of a secp256k1 signing key, an X25519 key-agreement key, and a wrapped LiteDB master key; 12-word BIP39 recovery phrase (BIP32 path m/7'/0'/0'/0/0); public-key pinning; unlock throttling; OpenTelemetry-ready diagnostics. UI-agnostic. See docs/AGENTWALLET.md.</Description>
    <Authors>Michael Herman</Authors>
    <Company>Web 7.0 Foundation</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://svrn7.net</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="NBitcoin" Version="7.0.37" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
    <PackageReference Include="Blake3" Version="2.0.0" />
    <!-- DPAPI (ProtectedData) is a Windows-only out-of-band package, used by
         DpapiPinStore and DpapiSecretProtector. Both are guarded by
         [SupportedOSPlatform("windows")]; other platforms fall back to the
         Null implementations (see IPinStore / ISecretProtector). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
