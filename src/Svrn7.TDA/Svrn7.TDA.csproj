<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>0.8.0</Version>
    <Authors>Michael Herman</Authors>
    <Company>Web 7.0 Foundation</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://svrn7.net</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Michael Herman (Alberta, Canada)</Copyright>
    <Description>
      Web 7.0 Trusted Digital Assistant (TDA) Host — DSA 0.24 Epoch 0.
      Implements the five Critical-priority DSA 0.24 components:
        1. KestrelListenerService  — POST /didcomm, HTTP/2 + mTLS inbound gate
        2. DIDCommMessageSwitchboard — sole inbox reader, pass-by-reference ObjectId routing
        3. RunspacePoolManager     — PowerShell RunspacePool lifecycle
        4. LobeManager             — eager/JIT LOBE loading from lobes.config.json
        5. Svrn7RunspaceContext    — $SVRN7 shared session variable for all runspaces
      Derived from: DSA 0.24 Epoch 0 — Parchment Programming Modeling Language (PPML).
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Default eager-LOBE list. Embedded in the assembly so a fresh instance can
         materialize <instance>/lobes/lobes.config.json (LobeManager.LoadLobeConfig)
         with no lobes/ folder next to the DLL. The per-instance copy, once written,
         is the operator-editable one (hot-reload watcher). -->
    <Content Remove="lobes.config.json" />
    <EmbeddedResource Include="lobes.config.json">
      <LogicalName>lobes.config.json</LogicalName>
    </EmbeddedResource>

    <!-- The lobes/ source tree is NOT copied to build/publish output. Since the
         per-identity redesign (docs/AGENTWALLET.md) LobeManager reads
         <instance>/lobes/, never <BaseDir>/lobes/, so a bin/**/lobes/ folder is
         dead weight. bin/**/lobes/ starts absent; the real per-instance
         <instance>/lobes/ is populated on demand by LobeInstaller from
         lobe-library/. The source lobes/ tree stays — BuildLOBEPackages globs it
         to produce dist/*.nupkg. Keep .lobe.json files out of the output too. -->
    <Content Update="lobes/**/*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <!-- admin-tools is deliberately NOT under lobes/ — LobeManager only discovers
         *.lobe.json under the lobes/ directory tree, so this module is never eager or
         JIT loaded into the Switchboard's dispatch InitialSessionState. It exists only
         for a human to Import-Module directly in a standalone PowerShell session. -->
    <Content Include="admin-tools/**/*.psm1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Svrn7.Core\Svrn7.Core.csproj" />
    <ProjectReference Include="..\Svrn7.DIDComm\Svrn7.DIDComm.csproj" />
    <ProjectReference Include="..\Svrn7.Society\Svrn7.Society.csproj" />
    <ProjectReference Include="..\Svrn7.Trust.AgentWallet\Svrn7.Trust.AgentWallet.csproj" />
  </ItemGroup>
  <!-- LOBE NuGet packaging — runs after Build, skipped when no LOBE source has changed -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</RepoRoot>
    <LobeDistDir>$(RepoRoot)\dist</LobeDistDir>
    <LobePackagesStamp>$(MSBuildProjectDirectory)\obj\lobe-packages.stamp</LobePackagesStamp>
  </PropertyGroup>
  <ItemGroup>
    <_LobeSource Include="$(MSBuildProjectDirectory)\lobes\**\*.lobe.json" />
    <_LobeSource Include="$(MSBuildProjectDirectory)\lobes\**\*.psm1" />
    <_LobeSource Include="$(MSBuildProjectDirectory)\lobes\**\*.psd1" />
  </ItemGroup>
  <Target Name="BuildLOBEPackages" AfterTargets="Build" Inputs="@(_LobeSource)" Outputs="$(LobePackagesStamp)">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepoRoot)\tools\Build-LOBEPackages.ps1&quot; -LobesDir &quot;$(MSBuildProjectDirectory)\lobes&quot; -OutDir &quot;$(LobeDistDir)&quot;" />
    <Touch Files="$(LobePackagesStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Publish task — separate from the binary publish. Copies the built LOBE
       .nupkg files to the machine-level LOBE library, the sanctioned way to
       populate it (docs/AGENTWALLET.md §D6/§D16). Flat {id}.{version}.nupkg
       layout — what LobeLibrary reads. Changed packages overwrite; unchanged
       ones are skipped, so a rebuilt LOBE is picked up. The binaries publish
       does NOT carry LOBE packages, and the TDA never seeds the library itself. -->
  <Target Name="PublishLOBEsToLibrary" AfterTargets="Publish">
    <PropertyGroup>
      <_LobeLibraryDir>$(USERPROFILE)\.web7-pando\lobe-library</_LobeLibraryDir>
    </PropertyGroup>
    <ItemGroup>
      <_LobeNupkgToLibrary Include="$(LobeDistDir)\*.nupkg" />
    </ItemGroup>
    <MakeDir Directories="$(_LobeLibraryDir)" Condition="'@(_LobeNupkgToLibrary)' != ''" />
    <Copy SourceFiles="@(_LobeNupkgToLibrary)"
          DestinationFolder="$(_LobeLibraryDir)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true"
          Condition="'@(_LobeNupkgToLibrary)' != ''" />
    <Message Importance="high"
             Text="PublishLOBEsToLibrary: published LOBE package(s) to $(_LobeLibraryDir)\ (@(_LobeNupkgToLibrary))"
             Condition="'@(_LobeNupkgToLibrary)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.7.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="System.Management.Automation" Version="7.4.6" />
    <PackageReference Include="Microsoft.PowerShell.Commands.Utility" Version="7.4.1" />
  </ItemGroup>
</Project>
