<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio "Publish" profile for the TDA.

  Publishes Svrn7.TDA (framework-dependent) and all of its dependent files —
  dependency assemblies, deps.json / runtimeconfig.json, the apphost, and the
  Content items (lobes/, admin-tools/, and lobe-packages/*.nupkg for first-run
  lobe-library seeding) — into the Web 7.0 Pando data root:

      %USERPROFILE%\.web7-pando\bin\Debug\net8.0\

  Use from Visual Studio:  Build ▸ Publish Svrn7.TDA ▸ profile "web7-pando".
  Use from the CLI:        dotnet publish src\Svrn7.TDA -c Debug -p:PublishProfile=web7-pando

  PublishDir is fixed to bin\Debug\net8.0 (matching the folder that exists);
  build with -c Debug so the binaries match. Change the one PublishDir line
  below if a different config/location is wanted.

  Only the TDA is published here — LOBE .nupkg publishing to
  ~/.web7-pando/lobe-library/ is a separate task (docs/AGENTWALLET.md §D16).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>

    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>

    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier />
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <PublishDir>$(USERPROFILE)\.web7-pando\bin\Debug\net8.0\</PublishDir>
    <publishUrl>$(USERPROFILE)\.web7-pando\bin\Debug\net8.0\</publishUrl>

    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
</Project>
